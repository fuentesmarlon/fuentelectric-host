# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.
#
# IMPORTANTE: el .env LOCAL debe apuntar al proyecto de Supabase de STAGING, nunca a producción.
# Las credenciales de producción viven solo en el hosting (Vercel → Environment Variables → Production).

# Entorno: produccion | staging | desarrollo  (muestra un aviso en pantalla y separa errores en Sentry)
NEXT_PUBLIC_ENTORNO="desarrollo"

# --- Base de datos (Supabase → Connect) ---
# App: pooler en modo "transaction" (puerto 6543). Recomendado en Vercel/serverless.
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASEÑA@aws-1-us-east-2.pooler.supabase.com:6543/postgres"
# Migraciones (`prisma migrate deploy`): pooler en modo "session" (puerto 5432) o conexión directa.
# Si no se define, las migraciones usan DATABASE_URL.
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASEÑA@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
# Opcional: conexiones máximas por instancia del servidor (por defecto 5)
# DATABASE_POOL_MAX="5"

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Solo servidor: permite generar códigos OTP. No exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (envío de códigos de acceso por correo) ---
RESEND_API_KEY=""

# --- Datos de prueba (pnpm db:seed, solo staging/desarrollo) ---
# Cuentas de acceso de prueba que el seed crea en Supabase Auth (opcional)
# SEED_ADMIN_EMAIL="admin.prueba@tu-dominio.com"
# SEED_ADMIN_PASSWORD=""
# SEED_TRABAJADOR_EMAIL="trabajador.prueba@tu-dominio.com"

# Opcional: token para subir source maps a Sentry durante el build
# SENTRY_AUTH_TOKEN=""
